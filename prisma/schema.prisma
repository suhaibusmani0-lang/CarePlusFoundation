generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model Donor {
  id         String     @id @default(auto()) @map("_id") @db.ObjectId
  name       String
  email      String
  phone      String
  pan_number String?
  donations  Donation[]
  created_at DateTime   @default(now())
}

model Donation {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  donor_id            String   @db.ObjectId
  donor               Donor    @relation(fields: [donor_id], references: [id])
  amount              Float
  razorpay_order_id   String   @unique
  razorpay_payment_id String?  @unique
  status              Status   @default(PENDING)
  created_at          DateTime @default(now())
}

enum Status {
  PENDING
  SUCCESS
  FAILED
}

model Blog {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String
  content   String
  imageUrl  String?
  author    String   @default("Admin")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model GalleryItem {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  title     String?
  imageUrl  String
  createdAt DateTime @default(now())
}
model ScholarshipApplication {
  id                  String   @id @default(auto()) @map("_id") @db.ObjectId
  student_name        String
  dob                 String
  gender              String
  class               String
  section             String?
  school_name         String
  school_address      String?
  student_mobile      String?
  enrollment_number   String?  @unique
  
  parent_name         String
  mother_name         String?
  parent_mobile       String
  email               String?
  address             String
  city                String?
  state               String?
  pin_code            String?
  category            String?
  religion            String?

  razorpay_order_id   String   @unique
  razorpay_payment_id String?  @unique
  status              Status   @default(PENDING)
  amount              Float    @default(270)
  
  created_at          DateTime @default(now())
  updated_at          DateTime @updatedAt
}
